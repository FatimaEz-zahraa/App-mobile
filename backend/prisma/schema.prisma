// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  avatarUrl     String?  @map("avatar_url")
  isActive      Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  physicalProfile       UserPhysicalProfile?
  measurements          UserMeasurement[]
  refreshTokens         RefreshToken[]
  runningSessions       RunningSession[]
  runningPersonalRecords RunningPersonalRecord[]
  fitnessPlans          FitnessPlan[]
  workoutSessions       WorkoutSession[]
  workoutSchedules      WorkoutSchedule[]
  workoutLogs           WorkoutLog[]
  nutritionPlans        NutritionPlan[]
  meals                 Meal[]
  nutritionLogs         NutritionLog[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference?
  goals                 UserGoal[]
  achievements          UserAchievement[]
  customExercises       Exercise[]

  @@map("users")
}

model UserPhysicalProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  birthDate    DateTime @map("birth_date") @db.Date
  gender       Gender?
  heightCm     Decimal  @map("height_cm") @db.Decimal(5, 2)
  weightKg     Decimal  @map("weight_kg") @db.Decimal(5, 2)
  wristCm      Decimal? @map("wrist_cm") @db.Decimal(4, 2)
  neckCm       Decimal? @map("neck_cm") @db.Decimal(4, 2)
  waistCm      Decimal? @map("waist_cm") @db.Decimal(4, 2)
  hipCm        Decimal? @map("hip_cm") @db.Decimal(4, 2)
  restingHr    Int?     @map("resting_hr")
  maxHr        Int?     @map("max_hr")
  fitnessLevel FitnessLevel? @map("fitness_level")
  healthNotes  String?  @map("health_notes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_physical_profiles")
}

model UserMeasurement {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 2)
  bodyFatPct   Decimal? @map("body_fat_pct") @db.Decimal(4, 2)
  muscleMassKg Decimal? @map("muscle_mass_kg") @db.Decimal(5, 2)
  bmi          Decimal? @db.Decimal(4, 2)
  measuredAt   DateTime @default(now()) @map("measured_at") @db.Date
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_measurements")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// RUNNING
// ─────────────────────────────────────────

model RunningSession {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  title             String?
  status            SessionStatus  @default(COMPLETED)
  startedAt         DateTime       @map("started_at")
  endedAt           DateTime?      @map("ended_at")
  durationSeconds   Int?           @map("duration_seconds")
  activeDurationSec Int?           @map("active_duration_sec")
  distanceMeters    Decimal        @default(0) @map("distance_meters") @db.Decimal(10, 2)
  avgSpeedKmh       Decimal?       @map("avg_speed_kmh") @db.Decimal(5, 2)
  maxSpeedKmh       Decimal?       @map("max_speed_kmh") @db.Decimal(5, 2)
  minSpeedKmh       Decimal?       @map("min_speed_kmh") @db.Decimal(5, 2)
  avgPaceSecPerKm   Int?           @map("avg_pace_sec_per_km")
  caloriesBurned    Decimal?       @map("calories_burned") @db.Decimal(8, 2)
  avgHeartRate      Int?           @map("avg_heart_rate")
  maxHeartRate      Int?           @map("max_heart_rate")
  minHeartRate      Int?           @map("min_heart_rate")
  elevationGainM    Decimal?       @map("elevation_gain_m") @db.Decimal(7, 2)
  elevationLossM    Decimal?       @map("elevation_loss_m") @db.Decimal(7, 2)
  maxAltitudeM      Decimal?       @map("max_altitude_m") @db.Decimal(7, 2)
  minAltitudeM      Decimal?       @map("min_altitude_m") @db.Decimal(7, 2)
  startLat          Decimal?       @map("start_lat") @db.Decimal(10, 8)
  startLng          Decimal?       @map("start_lng") @db.Decimal(11, 8)
  endLat            Decimal?       @map("end_lat") @db.Decimal(10, 8)
  endLng            Decimal?       @map("end_lng") @db.Decimal(11, 8)
  weatherTempC      Decimal?       @map("weather_temp_c") @db.Decimal(4, 1)
  weatherCondition  String?        @map("weather_condition")
  routeData         Json?          @map("route_data")
  isSynced          Boolean        @default(false) @map("is_synced")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gpsPoints RunningGpsPoint[]
  splits    RunningSplit[]

  @@index([userId, startedAt(sort: Desc)])
  @@map("running_sessions")
}

model RunningGpsPoint {
  id          BigInt   @id @default(autoincrement())
  sessionId   String   @map("session_id")
  sequenceNum Int      @map("sequence_num")
  latitude    Decimal  @db.Decimal(10, 8)
  longitude   Decimal  @db.Decimal(11, 8)
  altitudeM   Decimal? @map("altitude_m") @db.Decimal(7, 2)
  speedKmh    Decimal? @map("speed_kmh") @db.Decimal(5, 2)
  heartRate   Int?     @map("heart_rate")
  recordedAt  DateTime @map("recorded_at")
  accuracyM   Decimal? @map("accuracy_m") @db.Decimal(5, 2)

  session RunningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sequenceNum])
  @@map("running_gps_points")
}

model RunningSplit {
  id           String  @id @default(uuid())
  sessionId    String  @map("session_id")
  splitNumber  Int     @map("split_number")
  distanceM    Decimal? @map("distance_m") @db.Decimal(8, 2)
  durationSec  Int?    @map("duration_sec")
  paceSecPerKm Int?    @map("pace_sec_per_km")
  avgSpeedKmh  Decimal? @map("avg_speed_kmh") @db.Decimal(5, 2)
  avgHeartRate Int?    @map("avg_heart_rate")
  calories     Decimal? @db.Decimal(6, 2)
  elevationGain Decimal? @map("elevation_gain") @db.Decimal(6, 2)

  session RunningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("running_splits")
}

model RunningPersonalRecord {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  sessionId   String?  @map("session_id")
  recordType  String   @map("record_type")
  value       Decimal  @db.Decimal(12, 4)
  unit        String?
  achievedAt  DateTime @map("achieved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordType])
  @@map("running_personal_records")
}

// ─────────────────────────────────────────
// FITNESS
// ─────────────────────────────────────────

model FitnessPlan {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  name           String
  description    String?
  goal           FitnessGoal?
  difficulty     FitnessLevel?
  durationWeeks  Int?         @map("duration_weeks")
  isActive       Boolean      @default(true) @map("is_active")
  startedAt      DateTime?    @map("started_at") @db.Date
  endsAt         DateTime?    @map("ends_at") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkoutSession[]

  @@map("fitness_plans")
}

model Exercise {
  id               String   @id @default(uuid())
  name             String
  nameFr           String?  @map("name_fr")
  description      String?
  category         MuscleCategory?
  equipment        String?
  difficulty       FitnessLevel?
  videoUrl         String?  @map("video_url")
  imageUrl         String?  @map("image_url")
  instructions     String?
  musclesPrimary   String[] @map("muscles_primary")
  musclesSecondary String[] @map("muscles_secondary")
  isCustom         Boolean  @default(false) @map("is_custom")
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  creator          User?             @relation(fields: [createdBy], references: [id])
  workoutExercises WorkoutExercise[]
  logSets          WorkoutLogSet[]

  @@map("exercises")
}

model WorkoutSession {
  id                String       @id @default(uuid())
  planId            String?      @map("plan_id")
  userId            String       @map("user_id")
  name              String
  description       String?
  sessionType       SessionType? @map("session_type")
  targetDurationMin Int?         @map("target_duration_min")
  targetCalories    Int?         @map("target_calories")
  difficulty        FitnessLevel?
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  plan      FitnessPlan?      @relation(fields: [planId], references: [id])
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  schedules WorkoutSchedule[]
  logs      WorkoutLog[]

  @@map("workout_sessions")
}

model WorkoutExercise {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  exerciseId  String   @map("exercise_id")
  orderIndex  Int      @map("order_index")
  sets        Int?
  reps        Int?
  durationSec Int?     @map("duration_sec")
  restSec     Int      @default(60) @map("rest_sec")
  weightKg    Decimal? @map("weight_kg") @db.Decimal(6, 2)
  distanceM   Decimal? @map("distance_m") @db.Decimal(8, 2)
  notes       String?

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])

  @@map("workout_exercises")
}

model WorkoutSchedule {
  id             String      @id @default(uuid())
  sessionId      String      @map("session_id")
  userId         String      @map("user_id")
  scheduledAt    DateTime    @map("scheduled_at")
  recurrence     Recurrence  @default(NONE)
  recurrenceEnd  DateTime?   @map("recurrence_end") @db.Date
  daysOfWeek     Int[]       @map("days_of_week")
  status         ScheduleStatus @default(SCHEDULED)
  reminderMin    Int         @default(30) @map("reminder_min")
  createdAt      DateTime    @default(now()) @map("created_at")

  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
  logs          WorkoutLog[]

  @@index([userId, scheduledAt])
  @@map("workout_schedules")
}

model WorkoutLog {
  id             String    @id @default(uuid())
  scheduleId     String?   @map("schedule_id")
  sessionId      String    @map("session_id")
  userId         String    @map("user_id")
  startedAt      DateTime  @map("started_at")
  endedAt        DateTime? @map("ended_at")
  durationSec    Int?      @map("duration_sec")
  caloriesBurned Decimal?  @map("calories_burned") @db.Decimal(8, 2)
  avgHeartRate   Int?      @map("avg_heart_rate")
  completionPct  Decimal?  @map("completion_pct") @db.Decimal(5, 2)
  rating         Int?
  feeling        Feeling?
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  schedule WorkoutSchedule? @relation(fields: [scheduleId], references: [id])
  session  WorkoutSession   @relation(fields: [sessionId], references: [id])
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets     WorkoutLogSet[]

  @@index([userId, startedAt(sort: Desc)])
  @@map("workout_logs")
}

model WorkoutLogSet {
  id          String   @id @default(uuid())
  logId       String   @map("log_id")
  exerciseId  String   @map("exercise_id")
  setNumber   Int      @map("set_number")
  repsDone    Int?     @map("reps_done")
  weightKg    Decimal? @map("weight_kg") @db.Decimal(6, 2)
  durationSec Int?     @map("duration_sec")
  distanceM   Decimal? @map("distance_m") @db.Decimal(8, 2)
  isCompleted Boolean  @default(true) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at")

  log      WorkoutLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id])

  @@map("workout_log_sets")
}

// ─────────────────────────────────────────
// NUTRITION
// ─────────────────────────────────────────

model Food {
  id              String   @id @default(uuid())
  name            String
  nameFr          String?  @map("name_fr")
  brand           String?
  barcode         String?
  caloriesPer100g Decimal? @map("calories_per100g") @db.Decimal(7, 2)
  proteinG        Decimal? @map("protein_g") @db.Decimal(6, 2)
  carbsG          Decimal? @map("carbs_g") @db.Decimal(6, 2)
  fatG            Decimal? @map("fat_g") @db.Decimal(6, 2)
  fiberG          Decimal? @map("fiber_g") @db.Decimal(6, 2)
  sugarG          Decimal? @map("sugar_g") @db.Decimal(6, 2)
  sodiumMg        Decimal? @map("sodium_mg") @db.Decimal(7, 2)
  category        String?
  isVerified      Boolean  @default(false) @map("is_verified")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  mealFoods MealFood[]

  @@map("foods")
}

model NutritionPlan {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  name          String
  goal          NutritionGoal?
  dailyCalories Int?            @map("daily_calories")
  proteinG      Decimal?        @map("protein_g") @db.Decimal(6, 2)
  carbsG        Decimal?        @map("carbs_g") @db.Decimal(6, 2)
  fatG          Decimal?        @map("fat_g") @db.Decimal(6, 2)
  isActive      Boolean         @default(true) @map("is_active")
  startedAt     DateTime?       @map("started_at") @db.Date
  createdAt     DateTime        @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals Meal[]

  @@map("nutrition_plans")
}

model Meal {
  id            String    @id @default(uuid())
  planId        String?   @map("plan_id")
  userId        String    @map("user_id")
  name          String
  mealType      MealType? @map("meal_type")
  scheduledTime String?   @map("scheduled_time")
  loggedAt      DateTime? @map("logged_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  plan  NutritionPlan? @relation(fields: [planId], references: [id])
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  foods MealFood[]

  @@map("meals")
}

model MealFood {
  id         String   @id @default(uuid())
  mealId     String   @map("meal_id")
  foodId     String   @map("food_id")
  quantityG  Decimal  @map("quantity_g") @db.Decimal(8, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id])

  @@map("meal_foods")
}

model NutritionLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  logDate       DateTime @default(now()) @map("log_date") @db.Date
  totalCalories Decimal? @map("total_calories") @db.Decimal(8, 2)
  totalProteinG Decimal? @map("total_protein_g") @db.Decimal(7, 2)
  totalCarbsG   Decimal? @map("total_carbs_g") @db.Decimal(7, 2)
  totalFatG     Decimal? @map("total_fat_g") @db.Decimal(7, 2)
  waterMl       Int?     @map("water_ml")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, logDate])
  @@map("nutrition_logs")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  scheduleId   String?            @map("schedule_id")
  type         String
  title        String
  body         String?
  data         Json?
  status       NotificationStatus @default(PENDING)
  scheduledFor DateTime?          @map("scheduled_for")
  sentAt       DateTime?          @map("sent_at")
  readAt       DateTime?          @map("read_at")
  pushToken    String?            @map("push_token")
  createdAt    DateTime           @default(now()) @map("created_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule WorkoutSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([userId, status, scheduledFor])
  @@map("notifications")
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  workoutReminders    Boolean  @default(true) @map("workout_reminders")
  achievementAlerts   Boolean  @default(true) @map("achievement_alerts")
  weeklySummary       Boolean  @default(true) @map("weekly_summary")
  nutritionReminders  Boolean  @default(true) @map("nutrition_reminders")
  pushEnabled         Boolean  @default(true) @map("push_enabled")
  pushToken           String?  @map("push_token")
  quietStartTime      String   @default("22:00") @map("quiet_start_time")
  quietEndTime        String   @default("07:00") @map("quiet_end_time")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─────────────────────────────────────────
// GOALS & ACHIEVEMENTS
// ─────────────────────────────────────────

model UserGoal {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  category     GoalCategory?
  title        String
  description  String?
  targetValue  Decimal?    @map("target_value") @db.Decimal(12, 4)
  currentValue Decimal     @default(0) @map("current_value") @db.Decimal(12, 4)
  unit         String?
  deadline     DateTime?   @db.Date
  status       GoalStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_goals")
}

model Achievement {
  id            String   @id @default(uuid())
  code          String   @unique
  nameFr        String?  @map("name_fr")
  nameEn        String?  @map("name_en")
  descriptionFr String?  @map("description_fr")
  iconUrl       String?  @map("icon_url")
  category      String?
  points        Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum SessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum SessionType {
  STRENGTH
  CARDIO
  HIIT
  YOGA
  STRETCHING
  CROSSFIT
  CYCLING
  SWIMMING
  OTHER
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  ENDURANCE
  FLEXIBILITY
  GENERAL_FITNESS
  REHABILITATION
}

enum NutritionGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  PERFORMANCE
  HEALTH
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

enum MuscleCategory {
  CHEST
  BACK
  SHOULDERS
  ARMS
  LEGS
  CORE
  GLUTES
  CARDIO
  FULL_BODY
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ScheduleStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum GoalCategory {
  RUNNING
  FITNESS
  NUTRITION
  WEIGHT
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  FAILED
  PAUSED
}

enum Feeling {
  TERRIBLE
  BAD
  OK
  GOOD
  GREAT
}
